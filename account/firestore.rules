rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 利用者は自分の登録情報だけを読み書きできる。一覧は Firebase コンソールで管理者が見る。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'affiliation', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.affiliation is string
        && request.resource.data.affiliation.size() > 0 && request.resource.data.affiliation.size() <= 200;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
